{
    "name": "fiber-interop/predis",
    "description": "Cooperative Predis for fiber-interop/api: a StreamConnection that waits on the socket with async\\readable()/writable(), so Redis commands suspend only the calling task.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "fiber-interop/api": "^0.2",
        "predis/predis": "^2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11",
        "fiber-interop/revolt": "*",
        "fiber-interop/amp": "*",
        "fiber-interop/react": "*",
        "fiber-interop/phasync": "*",
        "fiber-interop/swoole": "*"
    },
    "autoload": {
        "psr-4": {
            "async\\predis\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "async\\predis\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "../api",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../scope",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../revolt",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../amp",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../react",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../phasync",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../swoole",
            "options": {
                "symlink": true
            }
        }
    ]
}
